{
  "expo": {
    "name": "CrossFit WOD",
    "slug": "crossfit-wod",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crossfit.wod"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.crossfit.wod"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "CrossFit WOD",
      "shortName": "WOD",
      "lang": "ko",
      "themeColor": "#FF6B35",
      "backgroundColor": "#121212",
      "description": "크로스핏 WOD 생성기 — 랜덤 또는 커스텀 운동 루틴을 만들어보세요",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    }
  }
}
